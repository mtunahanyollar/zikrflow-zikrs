[
  {"id":"a0000001-1001-1001-1001-100000000001","arabicText":"سُبْحَانَ الله","turkishTitle":"Subhanallah","turkishDescription":"Allah'ı noksanlıklardan tenzih etme zikirleri.","englishTitle":"Subhanallah","englishDescription":"Glory be to God.","category":"Daily","targetCount":33,"audioFileName":"subhanallah"},
  {"id":"a0000002-1002-1002-1002-100000000002","arabicText":"الْحَمْدُ لِلَّهِ","turkishTitle":"Elhamdulillah","turkishDescription":"Şükür ifadesi, günlük zikir.","englishTitle":"Alhamdulillah","englishDescription":"All praise is due to God.","category":"Daily","targetCount":33,"audioFileName":"alhamdulillah"},
  {"id":"a0000003-1003-1003-1003-100000000003","arabicText":"اللَّهُ أَكْبَرُ","turkishTitle":"Allahu Akbar","turkishDescription":"Yücelik ve büyüklük ifade eden zikir.","englishTitle":"Allahu Akbar","englishDescription":"God is the Greatest.","category":"Daily","targetCount":33,"audioFileName":"allahu_akbar"},
  {"id":"a0000004-1004-1004-1004-100000000004","arabicText":"لا إِلٰهَ إِلَّا الله","turkishTitle":"La ilaha illa Allah","turkishDescription":"Tevhid ifadesi, iman özeti.","englishTitle":"La ilaha illa Allah","englishDescription":"There is no god but God.","category":"Daily","targetCount":100,"audioFileName":"la_ilaha_illa_allah"},
  {"id":"a0000005-1005-1005-1005-100000000005","arabicText":"أَسْتَغْفِرُ اللهَ","turkishTitle":"Estağfirullah","turkishDescription":"Günahların affı için sıkça söylenen.","englishTitle":"Astaghfirullah","englishDescription":"I seek forgiveness from God.","category":"Forgiveness","targetCount":100,"audioFileName":"astaghfirullah"},
  {"id":"a0000006-1006-1006-1006-100000000006","arabicText":"يَا سَتَّار","turkishTitle":"Ya Settar","turkishDescription":"Ayıpları örtme, sıkıntılarda yardım için okunur.","englishTitle":"Ya Sattar","englishDescription":"Recited for concealment of faults and success in feared matters.","category":"Protection","targetCount":100,"audioFileName":"ya_sattar"},
  {"id":"a0000007-1007-1007-1007-100000000007","arabicText":"يَا رَزَّاق","turkishTitle":"Ya Rezzak","turkishDescription":"Rızık ve ticaret için okunur.","englishTitle":"Ya Razzaq","englishDescription":"The Provider; recited for sustenance and livelihood.","category":"Wealth","targetCount":308,"audioFileName":"ya_razzaq"},
  {"id":"a0000008-1008-1008-1008-100000000008","arabicText":"آية الكرسي","turkishTitle":"Ayet-el Kürsi","turkishDescription":"Koruma için sıkça okunan Bakara 255.","englishTitle":"Ayat al-Kursi","englishDescription":"Verse of the Throne; recited for protection and blessing.","category":"Protection","targetCount":7,"audioFileName":"ayet_el_kursi"},
  {"id":"a0000009-1009-1009-1009-100000000009","arabicText":"رَبِّ زِدْنِي عِلْمًا","turkishTitle":"Rabbi zidni ilma","turkishDescription":"İlim artışı için dua.","englishTitle":"My Lord, increase me in knowledge","englishDescription":"Supplication for increase in knowledge.","category":"Success","targetCount":11,"audioFileName":"rabbi_zidni_ilma"},
  {"id":"a000000A-100A-100A-100A-10000000000A","arabicText":"سُبْحَانَ اللهِ وَبِحَمْدِهِ","turkishTitle":"Subhanallahi wa bihamdihi","turkishDescription":"Günahların affı ve büyük sevap için.","englishTitle":"Glory be to God and praise Him","englishDescription":"Phrase of glorification and praise.","category":"Daily","targetCount":100,"audioFileName":"subhanallahi_wa_bihamdihi"},
  {"id":"a000000B-100B-100B-100B-10000000000B","arabicText":"يَا شَافِي","turkishTitle":"Ya Şafi","turkishDescription":"Şifa için okunur, şifa dileyenlere tavsiye edilir.","englishTitle":"Ya Shafi","englishDescription":"The Healer; recited for health and cure.","category":"Health","targetCount":100,"audioFileName":"ya_shafi"},
  {"id":"a000000C-100C-100C-100C-10000000000C","arabicText":"اللَّهُمَّ أَنْتَ السَّلَام","turkishTitle":"Allahumma anta's-Selam","turkishDescription":"Esenlik ve kurtuluş için dua.","englishTitle":"O God, You are Peace","englishDescription":"Supplication affirming God's peace-giving nature.","category":"Protection","targetCount":11,"audioFileName":"allahumma_antas_salam"},
  {"id":"a000000D-100D-100D-100D-10000000000D","arabicText":"يَا لَطِيف","turkishTitle":"Ya Latif","turkishDescription":"Nazik yardım ve kolaylık için okunur.","englishTitle":"Ya Latif","englishDescription":"The Subtle One; recited for ease and gentle help.","category":"Protection","targetCount":100,"audioFileName":"ya_latif"},
  {"id":"a000000E-100E-100E-100E-10000000000E","arabicText":"يَا مَنّْ","turkishTitle":"Ya Mann","turkishDescription":"Cömertlik ve ikram için dilenir.","englishTitle":"Ya Mann","englishDescription":"The Munificent; invoked for generosity and provision.","category":"Wealth","targetCount":100,"audioFileName":"ya_mann"},
  {"id":"a000000F-100F-100F-100F-10000000000F","arabicText":"يا غفور","turkishTitle":"Ya Ghafoor","turkishDescription":"Bağışlanma niyazı için okunur.","englishTitle":"Ya Ghafoor","englishDescription":"The Most Forgiving; recited seeking pardon.","category":"Forgiveness","targetCount":100,"audioFileName":"ya_ghafoor"},
  {"id":"a0000010-1010-1010-1010-100000000010","arabicText":"اللَّهُمَّ صَلِّ عَلَى مُحَمَّدٍ","turkishTitle":"Salavat","turkishDescription":"Peygambere salavat getirme zikri.","englishTitle":"Salawat on the Prophet","englishDescription":"Invocation of blessings on Prophet Muhammad (PBUH).","category":"Daily","targetCount":100,"audioFileName":"salavat"},
  {"id":"a0000011-1011-1011-1011-100000000011","arabicText":"اللَّهُمَّ إِنِّي أَسْأَلُكَ العَافِيَةَ","turkishTitle":"Afiyet duası","turkishDescription":"Sağlık, afiyet ve felaketten korunma için kısa dua.","englishTitle":"Supplication for well-being","englishDescription":"A short dua asking for wellbeing and protection.","category":"Health","targetCount":33,"audioFileName":"afiyet_duasi"},
  {"id":"a0000012-1012-1012-1012-100000000012","arabicText":"آسْتَغْفِرُكَ","turkishTitle":"Estağfiruke","turkishDescription":"Kişisel tövbe ve af için kullanılan kısa zikir.","englishTitle":"I seek Your forgiveness","englishDescription":"Short phrase of seeking God's forgiveness.","category":"Forgiveness","targetCount":100,"audioFileName":"estaghfiruke"},
  {"id":"a0000013-1013-1013-1013-100000000013","arabicText":"اللَّهُمَّ عَافِنِي","turkishTitle":"Allahumme 'afini","turkishDescription":"Sağlık ve esenlik dua ifadeleri arasında kısa bir talep.","englishTitle":"O God, grant me well-being","englishDescription":"Supplication asking for health and safety.","category":"Health","targetCount":33,"audioFileName":"allahumme_afini"},
  {"id":"a0000014-1014-1014-1014-100000000014","arabicText":"يَا قَهَّار","turkishTitle":"Ya Qahhar","turkishDescription":"Baskın güçlere karşı yardım isteme zikri.","englishTitle":"Ya Qahhar","englishDescription":"The Subduer; recited to seek overcoming difficulties.","category":"Protection","targetCount":100,"audioFileName":"ya_qahhar"},
  {"id":"a0000015-1015-1015-1015-100000000015","arabicText":"يا غنى","turkishTitle":"Ya Ghani","turkishDescription":"Maddi-manevi yeterlilik için okunur.","englishTitle":"Ya Ghani","englishDescription":"The Self-Sufficient; recited for sufficiency and independence.","category":"Wealth","targetCount":100,"audioFileName":"ya_ghani"},
  {"id":"a0000016-1016-1016-1016-100000000016","arabicText":"اللّهُ لا إلهَ إلاّ هُوَ","turkishTitle":"La ilaha illa Hu","turkishDescription":"Allah’ın birliği ve tekliği onayını ifade eden kısa zikr.","englishTitle":"There is no deity except Him","englishDescription":"Declaration of God's uniqueness and oneness." ,"category":"Daily","targetCount":100,"audioFileName":"la_ilaha_illa_hu"},
  {"id":"a0000017-1017-1017-1017-100000000017","arabicText":"بِسْمِ اللهِ الرَّحْمَنِ الرَّحِيمِ","turkishTitle":"Besmele","turkishDescription":"İşlere başlarken okunan besmele.","englishTitle":"Bismillah ar-Rahman ar-Rahim","englishDescription":"In the name of God, the Most Gracious, Most Merciful.","category":"Daily","targetCount":99,"audioFileName":"besmele"},
  {"id":"a0000018-1018-1018-1018-100000000018","arabicText":"اللَّهُمَّ رَبَّنَا آتِنَا فِي الدُّنْيَا حَسَنَةً","turkishTitle":"Rabbena duası","turkishDescription":"Dünya ve ahiret hayrı için kısa bir dua (Rabbana).","englishTitle":"Our Lord, give us good in this world","englishDescription":"Supplication for goodness in this life and the next." ,"category":"General","targetCount":11,"audioFileName":"rabbena_duasi"},
  {"id":"a0000019-1019-1019-1019-100000000019","arabicText":"اللَّهُمَّ أَجِرْنِي مِنَ النَّارِ","turkishTitle":"Cehennemden korunma duası","turkishDescription":"Ahiret kurtuluşu için kısa dua.","englishTitle":"Save me from the Fire","englishDescription":"Supplication for protection from Hellfire.","category":"Protection","targetCount":11,"audioFileName":"cehennem_korunma"},
  {"id":"a0000020-1020-1020-1020-100000000020","arabicText":"اللّهُمَّ اكْفِنِي بِحَلَالِكَ عَنْ حَرَامِكَ","turkishTitle":"Helal ile yetinme duası","turkishDescription":"Helal ile kâfi olma talebi.","englishTitle":"Suffice me with Your lawful provisions","englishDescription":"Supplication for being content with lawful provision.","category":"Wealth","targetCount":33,"audioFileName":"helal_ile_kafin"},
  {"id":"a0000021-1021-1021-1021-100000000021","arabicText":"لا حَوْلَ وَلا قُوَّةَ إِلا بِاللَّهِ","turkishTitle":"La havle","turkishDescription":"Kuvvet ve yardımın yalnız Allah'tan olduğunu ifade eden zikir.","englishTitle":"There is no power or might except with God","englishDescription":"Expression acknowledging reliance on God alone.","category":"Daily","targetCount":33,"audioFileName":"la_hawla"},
  {"id":"a0000022-1022-1022-1022-100000000022","arabicText":"سبحان الله وبحمده","turkishTitle":"Subhanallah wa bihamdihi","turkishDescription":"Günlük sevap ve bağışlanma için sık okunur.","englishTitle":"Glory be to God and praise Him","englishDescription":"Phrase of glorification and praise, recommended often." ,"category":"Daily","targetCount":100,"audioFileName":"subhanallah_bihamdihi"},
  {"id":"a0000023-1023-1023-1023-100000000023","arabicText":"اللَّهُمَّ لَا سَهْلَ إِلَّا مَا جَعَلْتَهُ سَهْلًا","turkishTitle":"Zorlukları kolaylaştırma duası","turkishDescription":"Zorlukların kolaylaştırılması için dua ve zikir." ,"englishTitle":"O God, nothing is easy except what You make easy","englishDescription":"Supplication for easing affairs." ,"category":"Protection","targetCount":33,"audioFileName":"zorluk_kolaylastir"},
  {"id":"a0000024-1024-1024-1024-100000000024","arabicText":"يا رحمن يا رحيم","turkishTitle":"Ya Rahman Ya Rahim","turkishDescription":"Merhamet duası; sıkça tekrarlanır.","englishTitle":"Ya Rahman Ya Rahim","englishDescription":"Invoking the Most Gracious, the Most Merciful." ,"category":"Daily","targetCount":100,"audioFileName":"ya_rahman_rahim"},
  {"id":"a0000025-1025-1025-1025-100000000025","arabicText":"يا جبار","turkishTitle":"Ya Cebbar","turkishDescription":"Güç ve yardım için okunur.","englishTitle":"Ya Jabbar","englishDescription":"Invoking the Compeller for help and strength." ,"category":"Protection","targetCount":100,"audioFileName":"ya_jabbar"},
  {"id":"a0000026-1026-1026-1026-100000000026","arabicText":"اللهم إني أسألك العفو والعافية","turkishTitle":"Affet ve afiyet dileme","turkishDescription":"Af ve sağlık için kısa dua.","englishTitle":"I ask You for pardon and wellbeing","englishDescription":"Supplication seeking pardon and well-being." ,"category":"Health","targetCount":50,"audioFileName":"af_ve_afiyet"},
  {"id":"a0000027-1027-1027-1027-100000000027","arabicText":"يا ودود","turkishTitle":"Ya Vedud","turkishDescription":"Sevgi ve muhabbet için okunur.","englishTitle":"Ya Wadud","englishDescription":"Invoking the Most Loving for harmony and love." ,"category":"General","targetCount":100,"audioFileName":"ya_vedud"},
  {"id":"a0000028-1028-1028-1028-100000000028","arabicText":"سبحان الله و بحمده سبحان الله العظيم","turkishTitle":"Uzun tesbihat kısımı","turkishDescription":"Çok okunan zikir kombinasyonu (kısa versiyon).","englishTitle":"Glory be to God and His is the Greatness","englishDescription":"Common combined phrases of glorification." ,"category":"Daily","targetCount":100,"audioFileName":"tesbihat_combo"},
